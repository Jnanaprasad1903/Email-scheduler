    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
