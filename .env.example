# =============================================================================
# ReachInbox Email Scheduler — environment variables
# Copy this file to .env and fill in real values.
# Never commit a real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (used by docker-compose and Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox_email_scheduler
POSTGRES_PORT=5432

# Prisma connection string — must match the values above
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox_email_scheduler?schema=public"

# -----------------------------------------------------------------------------
# Redis (used by docker-compose and BullMQ)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=reachinbox
REDIS_PORT=6379
REDIS_URL="redis://:reachinbox@localhost:6379"

# -----------------------------------------------------------------------------
# Elasticsearch (used by docker-compose and the search client)
# -----------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL="http://localhost:9200"

# -----------------------------------------------------------------------------
# Worker Settings (BullMQ)
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# SMTP Configuration (Ethereal for dev)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal-user
SMTP_PASS=ethereal-pass

